{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug TsaElectronics.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/TsaElectronics.Api/bin/Debug/net10.0/TsaElectronics.Api.dll",
      "cwd": "${workspaceFolder}/src/TsaElectronics.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
